# Copy to .env. Never commit real credentials.

# Target model (DeepSeek-V4-Flash for the paper's non-TB2 benchmarks)
DEEPSEEK_API_KEY=<your-deepseek-api-key>
WORLDCALIB_MODEL=deepseek-v4-flash
WORLDCALIB_BASE_URL=https://api.deepseek.com/v1

# Claude-compatible proposer endpoint (Kimi-K2.6/K2.7 in the paper)
# Both fields are required for Kimi; explicit CLI proposer flags override them.
KIMI_API_KEY=<your-kimi-api-key>
KIMI_BASE_URL=<your-claude-compatible-endpoint>

# Optional Codex proposer authentication uses the normal Codex configuration.
# CODEX_HOME=/path/to/codex-home

# LongMemEval judge and trace embeddings
TOGETHER_API_KEY=<your-together-api-key>
OPENAI_API_KEY=<your-openai-api-key>

# GAIA gated dataset and search tools
HF_TOKEN=<your-huggingface-token>
TAVILY_API_KEY=<optional-tavily-key>
SERPER_API_KEY=<optional-serper-key>

# External benchmark roots (not bundled)
APPWORLD_ROOT=/path/to/appworld-data
APPWORLD_PYTHON=/path/to/appworld-env/bin/python
SPIDER2_ROOT=/path/to/Spider2/spider2-lite
TOOLATHLON_ROOT=/path/to/Toolathlon
TB2_TASKS_PATH=/path/to/terminal-bench-2/tasks
TB2_TERMINUS2_SOURCE=/path/to/terminus2-source
HARBOR_BINARY=harbor

# Optional provider endpoint for the MiniMax-M3 TB2 target
TB2_API_BASE=<openai-compatible-endpoint-if-required>
