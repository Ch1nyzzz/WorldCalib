# Python/build state
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
/.venv/
/.venv-*/

# Secrets and local configuration
/.env
/.env.*
!/.env.example

# Runtime and experiment products (never part of the source release)
/runs/
/results/
/logs/
/artifacts/
/.tmp/
/.spider2_episodic_memory.jsonl*

# External datasets, benchmark checkouts, and agent sources
/data/
/third_party/
/references/
/tools/
/skills/
/cable_bills/

# Common local media/transcription artifacts
/*.mp3
/*.wav
/*.mp4
/*.srt
/*.tsv
/*.vtt
/*.xlsx

# Temporary no-index diffs emitted by evaluation tooling
/memomemo_candidate.*.json
